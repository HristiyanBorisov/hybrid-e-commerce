PORT=3000

# DB_DATABASE, DB_USERNAME and DB_PASSWORD come from the root .env (via docker-compose.yml)
DB_HOST=postgres
DB_PORT=5432

# Login tokens: RS256 key pair created by `make keys` (mounted at /keys)
JWT_PRIVATE_KEY_PATH=/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/keys/public/jwt-public.pem
# Token lifetime in seconds (1 hour)
JWT_TTL=3600
# bcrypt cost for password hashes
BCRYPT_ROUNDS=12

# Redis: the product cache in database 2, queued jobs in database 3 (Laravel uses 0 and 1)
CACHE_REDIS_URL=redis://redis:6379/2
QUEUE_REDIS_URL=redis://redis:6379/3

# Product search (Elasticsearch): the index is filled from the catalog
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=products

# Outgoing email — Mailpit catches everything locally (inbox: http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="Hybrid Shop <orders@shop.test>"

# The admin service's internal API (catalog writes are forwarded there). INTERNAL_API_KEY comes from the root .env.
ADMIN_SERVICE_INTERNAL_URL=http://nginx:8081/internal/v1
