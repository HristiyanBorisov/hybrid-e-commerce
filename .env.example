# Docker Compose settings.
# Only values that several containers must agree on live here (e.g. database credentials:
# postgres creates the databases, the services connect to them). Everything else is in
# each service's own .env file.

# ---- Ports on your machine
# http://localhost:8080 — nginx (admin panel + /api)
APP_PORT=8080
# http://localhost:8025 — Mailpit inbox
MAILPIT_PORT=8025
# localhost:5433 — PostgreSQL, for a database GUI
FORWARD_DB_PORT=5433

# ---- PostgreSQL superuser (used only by the postgres container to create the databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# ---- admin-service (Laravel) database
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=admin_service
ADMIN_DB_PASSWORD=secret

# ---- api-gateway (NestJS) database
GATEWAY_DB_NAME=gateway_db
GATEWAY_DB_USER=api_gateway
GATEWAY_DB_PASSWORD=secret

# ---- Login cookie — both services set it, so its flags must match
# true in production (sent over HTTPS only); false for http://localhost
AUTH_COOKIE_SECURE=false

# ---- Service-to-service API key — sent with every call between the two services, so both need the same value.
# Change it in production.
INTERNAL_API_KEY=local-dev-internal-api-key
